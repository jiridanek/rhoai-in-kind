 func (p *OAuthProxy) CheckRequestAuth(req *http.Request) (*providers.SessionState, error) {
+	// In-kind: accept a raw client Bearer token directly as the session's access
+	// token. The downstream kube-rbac-proxy performs the real K8s TokenReview
+	// (user attribution + RBAC), so we only need to carry the token through.
+	// This avoids the openshift provider's ValidateRequest (which needs a
+	// -openshift-sar path match + a registered K8s authenticator).
+	if auth := req.Header.Get("Authorization"); auth != "" {
+		if parts := strings.SplitN(auth, " ", 2); len(parts) == 2 && parts[0] == "Bearer" && parts[1] != "" {
+			return &providers.SessionState{User: "bearer", AccessToken: parts[1]}, nil
+		}
+	}
 	// handle advanced validation
 	return p.provider.ValidateRequest(req)
 }
