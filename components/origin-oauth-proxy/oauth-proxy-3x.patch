diff --git i/logging_handler.go w/logging_handler.go
index 17fca97..60f70d5 100644
--- i/logging_handler.go
+++ w/logging_handler.go
@@ -4,6 +4,7 @@
 package main
 
 import (
+	"bufio"
 	"fmt"
 	"io"
 	"net"
@@ -60,6 +61,17 @@ func (l *responseLogger) Status() int {
 	return l.status
 }
 
+// Hijack delegates to the underlying ResponseWriter when it supports it,
+// so that websocket upgrade requests can pass through the logging wrapper.
+// Without this, the downstream wsutil proxy fails with "Not a hijacker?".
+func (l *responseLogger) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	hj, ok := l.w.(http.Hijacker)
+	if !ok {
+		return nil, nil, fmt.Errorf("underlying ResponseWriter does not support hijacking")
+	}
+	return hj.Hijack()
+}
+
 func (l *responseLogger) Size() int {
 	return l.size
 }
